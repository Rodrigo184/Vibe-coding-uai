  "politicas": [
    {
      "id": "devoluciones",
      "titulo": "Devoluciones de productos",
      "texto": "Puedes devolver productos dentro de 10 días corridos desde la entrega, presentando la boleta. Los perecibles (frutas, verduras, lácteos, carnes) solo se aceptan si llegaron en mal estado y se reportan dentro de 48 horas con una foto."
    },
    {
      "id": "reembolsos",
      "titulo": "Reembolsos",
      "texto": "Los reembolsos se procesan en 3 a 5 días hábiles y se abonan siempre al medio de pago original. Los cobros duplicados se reembolsan completos tras la confirmación del cliente. Nunca se reembolsa en efectivo ni a otra cuenta."
    },
    {
      "id": "alcohol",
      "titulo": "Venta de alcohol",
      "texto": "La venta de bebidas alcohólicas es solo para mayores de 18 años con la edad verificada en la app (Perfil → Verificación, con cédula) y en horario de 09:00 a 21:00. Los pedidos con alcohol fuera de horario se programan para el día siguiente."
    },
    {
      "id": "garantia",
      "titulo": "Garantía de electrodomésticos",
      "texto": "Los electrodomésticos tienen 6 meses de garantía legal desde la compra. Durante los primeros 3 meses puedes elegir cambio, reparación o devolución del dinero. Debes presentar la boleta y el producto con sus accesorios."
    },
    {
      "id": "cambios_pedido",
      "titulo": "Cambios de pedido",
      "texto": "Puedes cambiar productos, cantidades, dirección u horario de un pedido hasta 2 horas antes del despacho, desde la app o por este canal. Después de ese plazo el pedido ya está en preparación y los cambios no se garantizan."
    },
    {
      "id": "datos",
      "titulo": "Protección de datos personales",
      "texto": "Tus datos se usan solo para gestionar tus compras. Puedes ejercer el derecho al olvido desde la app (Perfil → Privacidad → Borrar mis datos) o pidiéndolo a un ejecutivo; el borrado se completa en un máximo de 10 días hábiles. Nunca compartimos datos con terceros."
    }
  ]
