# ─── Agent Explorer Platform · variables de entorno ─────────────────────────────
# Copia este archivo a .env (cp .env.example .env). La clave vive SOLO en el backend.

# OpenAI — obligatoria para usar modelos reales.
# Si queda vacía, la plataforma arranca en MODO DEMO: un LLM simulado determinístico
# (tools, reglas, memoria, Redis y evals son reales; solo el "razonamiento" es simulado).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# Redis (en docker compose se sobrescribe a redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0
APP_ENV=dev
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Límites por turno
MAX_TURN_COST_USD=0.05
MAX_TURN_SECONDS=25
MAX_LLM_CALLS_PER_TURN=8
CHAT_RATE_LIMIT_PER_MIN=20

# USD por millón de tokens; editable
PRICES_JSON={"gpt-4o-mini":{"in":0.15,"out":0.60},"gpt-4o":{"in":2.50,"out":10.00},"text-embedding-3-small":{"in":0.02,"out":0}}

# CORS (en producción, el dominio del frontend; p. ej. https://agentes.tu-dominio.cl)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Modo demo sin clave (true/false). Con false y sin clave, las llamadas LLM fallan con error claro.
DEMO_MODE_WITHOUT_KEY=true

# Langfuse (opcional; se desactiva si faltan). Requiere `pip install langfuse`.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
